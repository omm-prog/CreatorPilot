# =====================================================================
# CreatorPilot Backend Environment Configuration
# =====================================================================

# 1. Gemini / Google AI API Key (REQUIRED for agent execution)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Parallel Search API Key (REQUIRED for Phase 2 research track)
# Sign up and get your API key at: https://platform.parallel.ai
PARALLEL_API_KEY=your_parallel_api_key_here

# 3. Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# 4. Allowed Origins for CORS (comma-separated or * for wildcard)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173

